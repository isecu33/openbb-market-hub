{
  "name": "OpenBB Market Hub",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" }
  },

  // .venv y node_modules del host (Windows) no sirven en Linux: se tapan con
  // volúmenes del contenedor y post-create.sh los rellena la primera vez.
  "mounts": [
    "source=openbb-market-hub-venv,target=${containerWorkspaceFolder}/.venv,type=volume",
    "source=openbb-market-hub-node-modules,target=${containerWorkspaceFolder}/frontend/node_modules,type=volume"
  ],

  "forwardPorts": [8000, 5173],
  "portsAttributes": {
    "8000": { "label": "Backend FastAPI (+ web compilada)" },
    "5173": { "label": "Frontend Vite (dev)" }
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"
      }
    }
  }
}
