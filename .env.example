# Copia este archivo a .env y rellena tus claves reales.
# cp .env.example .env

# Financial Modeling Prep — usado para Government Trades, fundamentales, etc.
# Clave gratuita en: https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=tu_clave_fmp_aqui

# FRED (Federal Reserve Economic Data) — usado para datos macro en la tesis temática.
# Clave gratuita en: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=tu_clave_fred_aqui

# Puerto del backend FastAPI local (opcional, por defecto 8000)
PORT=8000
