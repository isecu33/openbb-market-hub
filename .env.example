# Copia este archivo a .env y rellena tus claves reales.
# cp .env.example .env

# Financial Modeling Prep — Government Trades, fundamentales, etc.
# Clave gratuita: https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=tu_clave_fmp_aqui

# FRED (Federal Reserve Economic Data) — datos macro para la tesis temática.
# Clave gratuita: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=tu_clave_fred_aqui

# Puerto del backend FastAPI local (opcional, por defecto 8000)
PORT=8000

# Divisa base para consolidar la cartera (por defecto EUR)
BASE_CURRENCY=EUR

# Cada cuántos minutos el scheduler refresca precios / evalúa alertas
PRICE_REFRESH_MINUTES=30
ALERT_CHECK_MINUTES=15

# Segundos que se cachea cada cotización antes de volver a pedirla al proveedor
# (protege la cuota gratuita de FMP cuando alertas y cartera piden lo mismo)
QUOTE_CACHE_TTL=120

# Segundos que se cachea el resultado de un trabajo de research (tesis,
# políticos) antes de recalcularlo si se vuelve a pedir
JOB_RESULT_TTL=900

# Cada cuántos minutos se descargan y puntúan noticias nuevas
NEWS_REFRESH_MINUTES=60

# Hora local a la que se genera la sugerencia diaria (la semanal, los lunes)
SUGGESTION_HOUR=08:30

# Opcional: clave de Anthropic para que las sugerencias incluyan un briefing
# redactado por Claude. Sin ella, se usa un resumen basado en reglas.
# https://platform.claude.com/
# ANTHROPIC_API_KEY=sk-ant-...
